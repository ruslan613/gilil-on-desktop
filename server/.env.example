# Local desktop defaults. The Windows packager copies this file to server/.env
# when no .env exists. Not production secrets — do not put real credentials here.
PORT=8788
JWT_SECRET=change_me_to_a_long_random_secret_stage2
MESSAGE_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
DATABASE_PATH=./data/gilil-on-stage2.db
LOGIN_RATE_MAX=5
LOGIN_RATE_WINDOW_MIN=15

# OTP email login (expires = 10 minutes)
OTP_TTL_MIN=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SEC=60
NODE_ENV=development
# Force mock mail (code only in server log). Use 0 / unset when Gmail App Password is set.
AUTH_OTP_MOCK=0

# Gmail API via OAuth2 — highest priority (no App Password needed).
# Google Cloud Console: enable Gmail API, OAuth client type "Desktop app", then:
#   node scripts/gmail-oauth-token.js path/to/client_secret.json
# Consent screen in "Testing" → refresh token expires in 7 days; publish to Production.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Real Gmail SMTP (App Password from Google Account → Security → App passwords)
GMAIL_USER=gililllight@gmail.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# SMTP_FROM=Gilil On <gililllight@gmail.com>

# Or generic SMTP
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Optional MT (LibreTranslate). Empty = MyMemory + phrase mock.
# TRANSLATE_URL=
# TRANSLATE_API_KEY=
# TRANSLATE_MOCK=1

# Voice STT (optional — mock transcript when unset)
# OPENAI_API_KEY=
# WHISPER_API_KEY=
# WHISPER_API_URL=https://api.openai.com/v1/audio/transcriptions
# GOOGLE_SPEECH_API_KEY=
# STT_MOCK=1

# Fail-closed: only emails in smtp_senders_allowlist may use shared SMTP (OTP to= must be listed; actor sends check actor email).
SMTP_ALLOWLIST_ENFORCE=1
